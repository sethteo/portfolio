<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{ description | escape }}">
  <meta name="color-scheme" content="dark light">
  <!-- Comma-separated tags appear on the post and in the archive filters. -->
  <meta name="post-tags" content="{{ topics | join(", ") | escape }}">
  <title>{{ title | escape }} — Seth Teo</title>
  <link rel="icon" href="../favicon.svg" type="image/svg+xml">
  <script src="../posts.js"></script>
  <script src="../script.js"></script>
  <link rel="stylesheet" href="../styles.css">
</head>
<body id="top">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="site-shell">
    <header class="site-header">
      <a class="wordmark" href="../index.html" aria-label="Seth Teo home">seth<span>.dev</span></a>
      <nav aria-label="Main navigation">
        <a href="../index.html#experience">Experience</a>
        <a href="../index.html#writing">Writing</a>
        <a href="../index.html#projects">Projects</a>
        <a href="../index.html#skills">Skills</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="Switch colour theme" hidden>
        <svg class="sun-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M20.5 13a8.5 8.5 0 0 1-9.5-9.5A8.5 8.5 0 1 0 20.5 13Z"/></svg>
      </button>
    </header>
    <main id="main">
      <article>
        <header class="article-header">
          <a class="back-link" href="index.html">← All posts</a>
          <p class="eyebrow"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time></p>
          <h1>{{ title | escape }}</h1>
          {% if lead or (lead is undefined and description) %}<p class="article-lead">{{ (lead if lead is defined else description) | escape }}</p>{% endif %}
        </header>
        <div class="article-body">
          {% if note %}<aside class="sample-note">{{ note | escape }}</aside>{% endif %}
          {{ content | safe }}
          <p class="article-end"><a href="index.html">← All posts</a> · <a href="../index.html#writing">Back to home</a></p>
        </div>
      </article>
    </main>
    <footer class="site-footer"><a href="../index.html">Seth Teo</a><a href="#top">Back to top ↑</a><span class="site-credit">Site co-authored with OpenAI Codex.</span></footer>
  </div>
</body>
</html>
